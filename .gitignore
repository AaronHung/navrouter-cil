# 資料與權重不進 repo
can_dataset/
*.bin
*.safetensors
*.h5
*.npz
**/pt_files/
checkpoints/
# 產物：大檔與逐張記錄不進版控；彙總表、MACHINE.md、log 可 commit
outputs/**/*.pt
outputs/**/per_slide*/
# 導覽器權重與離線快取（連同 .done 標記）只留在本機，避免別台 clone 後誤跳過
outputs/navcil/*/bank/
outputs/navcil/*/cache/
outputs/navcil/*/lora/
# cache/text/ 的 f_txt_*.pt 例外：Mac 用 CONCH 算一次後 commit（MSI 直接讀）
!cache/text/*.pt
# reference/v9 的封存檔例外（有 SHA256SUMS.txt）
!reference/v9/*.pt
# Python / OS
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.venv/
